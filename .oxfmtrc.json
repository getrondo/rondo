{
    "singleQuote": true,
    "printWidth": 140,
    "tabWidth": 4,
    "semi": true,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "sortImports": {
        "groups": ["builtin", "external", "parent", "sibling", "index", "type", "unknown"],
        "ignoreCase": true,
        "internalPattern": [],
        "newlinesBetween": true,
        "order": "asc",
        "partitionByComment": true,
        "partitionByNewline": false,
        "sortSideEffects": false
    },
    "sortPackageJson": false,
    "ignorePatterns": [".agents/**", "docs/**", "**/*.md", "drizzle/**", "pnpm-lock.yaml"]
}

{
    "name": "@rondo/root",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "ts": "turbo run ts //#ts:root",
        "ts:root": "tsrs -p .",
        "lint:check": "effect-tsgo --tsrs-lint oxlint --type-aware --deny-warnings",
        "lint:fix": "effect-tsgo --tsrs-lint oxlint --type-aware --fix --deny-warnings",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "deadcode": "knip",
        "cpd": "jscpd",
        "test": "turbo run test --concurrency=2",
        "test:watch": "vitest",
        "check": "pnpm fmt:check && pnpm ts && pnpm lint:check && pnpm deadcode && pnpm cpd && pnpm test",
        "prepare": "husky",
        "db:up": "docker compose up -d --wait postgres",
        "db:down": "docker compose down",
        "db:generate": "pnpm --filter @rondo/db db:generate",
        "db:migrate": "pnpm --filter @rondo/db db:migrate",
        "db:check": "pnpm --filter @rondo/db db:check"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@commitlint/config-pnpm-scopes": "21.2.2",
        "@effect/tsgo": "0.73.4",
        "@effect/vitest": "4.1.5",
        "@types/node": "26.6.6",
        "@typescript-eslint/eslint-plugin": "8.73.0",
        "effect": "4.1.5",
        "eslint": "10.15.0",
        "eslint-plugin-n": "18.5.0",
        "eslint-plugin-no-comment-slop": "0.6.1",
        "eslint-plugin-regexp": "3.3.3",
        "eslint-plugin-slop": "0.1.3",
        "husky": "9.1.7",
        "jscpd": "5.4.2",
        "knip": "6.44.1",
        "lint-staged": "17.6.0",
        "oxfmt": "0.79.0",
        "oxlint": "1.94.0",
        "tsrs": "7.1.0-beta.tsrs3",
        "turbo": "2.11.10",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vitest": "5.1.0"
    },
    "engines": {
        "node": ">=26.13.0"
    },
    "packageManager": "pnpm@12.18.0"
}

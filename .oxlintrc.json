    "overrides": [
        {
            "files": ["**/*.service.ts", "**/service/**/*.ts"],
            "rules": {
                "max-lines-per-function": "off",
                "rondo/effect-no-imperative": "error",
                "rondo/effect-no-run": "error"
            }
        },
        {
            "files": ["**/*.test.ts"],
            "plugins": ["vitest"],
            "rules": {
                "vitest/expect-expect": "off",
                "vitest/no-commented-out-tests": "error",
                "vitest/no-conditional-expect": "error",
                "vitest/no-disabled-tests": "warn",
                "vitest/no-focused-tests": "error",
                "vitest/no-identical-title": "error",
                "vitest/no-import-node-test": "error",
                "vitest/no-interpolation-in-snapshots": "error",
                "vitest/no-mocks-import": "error",
                "vitest/no-standalone-expect": "off",
                "vitest/no-unneeded-async-expect-function": "error",
                "vitest/prefer-called-exactly-once-with": "error",
                "vitest/require-local-test-context-for-concurrent-snapshots": "error",
                "vitest/valid-describe-callback": "error",
                "vitest/valid-expect": "error",
                "vitest/valid-expect-in-promise": "error",
                "vitest/valid-title": "error",
                "no-await-in-loop": "off",
                "no-undefined": "off",
                "max-classes-per-file": "off",
                "max-lines-per-function": "off",
                "max-lines": "off",
                "func-names": "off",
                "promise/no-nesting": "off",
                "typescript/unbound-method": "off",
                "vitest/consistent-test-it": [
                    "error",
                    {
                        "fn": "it"
                    }
                ],
                "vitest/require-mock-type-parameters": "off",
                "vitest/no-conditional-in-test": "off"
            }
        },
        {
            "files": ["**/*.{ts,tsx}"],
            "rules": {
                "rondo/effect-fn-name": "error",
                "rondo/effect-service-id": "error",
                "rondo/shared-guards": "error"
            }
        },
        {
            "files": ["**/type/*.type.ts"],
            "rules": {
                "no-redeclare": "off"
            }
        },
        {
            "files": ["**/*.{js,mjs,cjs}"],
            "rules": {
                "typescript/no-unsafe-argument": "off",
                "typescript/no-unsafe-assignment": "off",
                "typescript/no-unsafe-call": "off",
                "typescript/no-unsafe-member-access": "off",
                "typescript/no-unsafe-return": "off"
            }
        },
        {
            "files": ["**/src/**/service/*.service.ts", "**/src/**/program/*.program.ts"],
            "rules": {
                "effecttsgo/global-console": "error",
                "effecttsgo/global-random": "error",
                "effecttsgo/global-timers": "error",
                "effecttsgo/new-promise": "error",
                "effecttsgo/process-env": "error"
            }
        },
        {
            "files": ["**/test/**", "tests/**", "**/worker/*.worker.ts"],
            "rules": {
                "effecttsgo/strict-effect-provide": "off",
                "effecttsgo/yield-in-call-argument": "off",
                "effecttsgo/global-date-in-effect": "off"
            }
        },
        {
            "files": ["**/test/**", "tests/**", "lint-rules/**"],
            "rules": {
                "no-restricted-properties": [
                    "error",
                    {
                        "object": "Reflect",
                        "property": "get",
                        "message": "Use typed property access, `in` narrowing, or decode the value with Schema."
                    },
                    {
                        "object": "Reflect",
                        "property": "apply",
                        "message": "Call the function directly with typed arguments."
                    },
                    {
                        "object": "vi",
                        "property": "mock",
                        "message": "Replace module mocking with a real dependency seam such as a test Layer."
                    },
                    {
                        "object": "vi",
                        "property": "doMock",
                        "message": "Replace module mocking with a real dependency seam such as a test Layer."
                    }
                ]
            }
        },
        {
            "files": ["scripts/**"],
            "rules": {
                "no-console": "off",
                "n/no-process-exit": "off",
                "effecttsgo/global-fetch": "off",
                "rondo/shared-guards": "off"
            }
        },
        {
            "files": ["apps/*/test/**", "packages/*/test/**", "tests/test-kit/**", "scripts/**/*.test.ts"],
            "rules": {
                "no-restricted-properties": [
                    "error",
                    {
                        "object": "Reflect",
                        "property": "get",
                        "message": "Use typed property access, `in` narrowing, or decode the value with Schema."
                    },
                    {
                        "object": "Reflect",
                        "property": "apply",
                        "message": "Call the function directly with typed arguments."
                    },
                    {
                        "object": "vi",
                        "property": "mock",
                        "message": "Replace module mocking with a real dependency seam such as a test Layer."
                    },
                    {
                        "object": "vi",
                        "property": "doMock",
                        "message": "Replace module mocking with a real dependency seam such as a test Layer."
                    },
                    {
                        "object": "Date",
                        "property": "now",
                        "message": "Real time makes a test depend on when it runs. Use TestClock, or fake timers with a fixed system time."
                    }
                ]
            }
        },
        {
            "files": ["packages/*/src/**/*.ts", "apps/*/src/**/*.ts"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "paths": [
                            {
                                "name": "effect",
                                "message": "Import Effect modules by subpath, e.g. import * as Effect from 'effect/Effect'"
                            },
                            {
                                "name": "zod",
                                "message": "Use effect/Schema."
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["packages/core/**/*.ts", "packages/db/**/*.ts"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "paths": [
                            {
                                "name": "effect",
                                "message": "Import Effect modules by subpath, e.g. import * as Effect from 'effect/Effect'"
                            },
                            {
                                "name": "zod",
                                "message": "Use effect/Schema."
                            }
                        ],
                        "patterns": [
                            {
                                "group": ["@rondo/ingest-telegram", "@rondo/ingest-telegram/*"],
                                "message": "ingest-telegram depends on core and db, never the reverse."
                            }
                        ]
                    }
                ]
            }
        }
    ]

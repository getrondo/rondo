        "unicorn/prefer-modern-math-apis": "error",
        "unicorn/prefer-negative-index": "error",
        "unicorn/prefer-node-protocol": "error",
        "unicorn/prefer-optional-catch-binding": "error",
        "unicorn/prefer-string-trim-start-end": "error",
        "unicorn/prefer-structured-clone": "error",
        "unicorn/require-array-join-separator": "error",
        "unicorn/require-module-attributes": "error",
        "typescript/no-unsafe-enum-assignment": "error",
        "eslint-js/no-undef-init": "error",
        "eslint-js/require-atomic-updates": [
            "error",
            {
                "allowProperties": true
            }
        ],
        "n/no-deprecated-api": "error",
        "n/no-extraneous-require": "error",
        "n/no-missing-require": "error",
        "n/no-process-exit": "error",
        "n/no-unpublished-import": "error",
        "n/no-unpublished-require": "error",
        "n/no-unsupported-features/es-builtins": "error",
        "n/process-exit-as-throw": "error",
        "n/hashbang": "error",
        "eslint-js/camelcase": [
            "error",
            {
                "properties": "never",
                "ignoreImports": true,
                "allow": ["^[ac]_"]
            }
        ],
        "ts-eslint/member-ordering": [
            "error",
            {
                "default": ["field", "constructor", "method"]
            }
        ],
        "n/no-unsupported-features/node-builtins": [
            "error",
            {
                "allowExperimental": true
            }
        ],
        "unicorn/no-useless-iterator-to-array": "error",
        "effecttsgo/all-of-map-to-for-each": "off",
        "effecttsgo/any-unknown-in-error-context": "error",
        "effecttsgo/effect-try-without-catch": "off",

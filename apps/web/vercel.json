{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "nextjs",
    "regions": ["fra1"],
    "installCommand": "pnpm install --frozen-lockfile",
    "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then DATABASE_URL=\"$DATABASE_URL_UNPOOLED\" pnpm -F @rondo/db db:migrate; fi && pnpm exec turbo run build --filter=@rondo/web",
    "crons": [
        {
            "path": "/api/cron/maintenance",
            "schedule": "0 4 * * *"
        },
        {
            "path": "/api/cron/teams",
            "schedule": "0 13-20 * * 1-5"
        },
        {
            "path": "/api/cron/teams",
            "schedule": "0 9-20 * * 0,6"
        }
    ]
}

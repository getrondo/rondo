{
    "$schema": "https://unpkg.com/knip@latest/schema.json",
    "workspaces": {
        ".": {
            "entry": ["lint-rules/**/*.mjs"],
            "project": ["*.{ts,mjs}", "lint-rules/**/*.mjs"],
            "ignoreDependencies": ["@effect/language-service", "@effect/vitest", "effect", "oxlint"]
        },
        "packages/*": {
            "project": ["src/**/*.ts"],
            "includeEntryExports": true
        },
        "tests/test-kit": {
            "entry": ["src/**/*.ts"],
            "includeEntryExports": true
        },
        "apps/*": {
            "entry": ["src/app/**/{page,layout,route,manifest}.{ts,tsx}"],
            "project": ["src/**/*.{ts,tsx}"]
        }
    }
}
